PORT=3000

# ── DHL Developer Portal (covers Bluedart) ───────────────────────────────
# Free self-serve account at https://developer.dhl.com/user/login
DHL_CLIENT_ID=
DHL_CLIENT_SECRET=

# ── FedEx Developer Portal ────────────────────────────────────────────────
# Free account at https://developer.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# ── Shiprocket (free account) ─────────────────────────────────────────────
# Free account at https://app.shiprocket.in/register
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── 2Captcha (optional, only needed for DTDC / India Post CAPTCHA fallback)
# $3 per 1000 solves at https://2captcha.com
TWOCAPTCHA_API_KEY=

# ── Proxy (optional, only needed for high-volume / rate-limit evasion) ────
# Format: http://user:pass@host:port
HTTP_PROXY=

# ── Cache TTL (seconds) ───────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
